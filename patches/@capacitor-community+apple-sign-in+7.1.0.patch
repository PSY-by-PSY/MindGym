+// PSY by PSY patch：提供授權面板要掛載的視窗。
+extension SignInWithApple: ASAuthorizationControllerPresentationContextProviding {
+    public func presentationAnchor(for controller: ASAuthorizationController) -> ASPresentationAnchor {
+        // 首選：Capacitor WebView 自己所在的視窗，一定是使用者正在看的那個。
+        if let window = self.bridge?.viewController?.view.window {
+            return window
+        }
+        // 備援：前景 scene 的 key window。iPad 多視窗時才會走到這裡。
+        let scenes = UIApplication.shared.connectedScenes.compactMap { $0 as? UIWindowScene }
+        if let window = scenes.first(where: { $0.activationState == .foregroundActive })?
+            .windows.first(where: { $0.isKeyWindow })
+            ?? scenes.flatMap({ $0.windows }).first(where: { $0.isKeyWindow }) {
+            return window
+        }
+        return ASPresentationAnchor()
+    }
+}
